# ─────────────────────────────────────────────────────────────────────────────
# Docket — Docker Compose environment
#
#   cp .env.docker.example .env
#   # edit APP_SECRET + NEXT_PUBLIC_APP_URL below, then:
#   docker compose up -d
#
# This is the DOCKER variant of .env.example. The only difference that matters
# is DATABASE_URL: inside Compose the database is reachable at the service
# hostname `postgres`, not `localhost`. Everything else is identical.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ───────────────────────────────────────────────────────────
# Pre-filled to match the bundled `postgres` service in docker-compose.yml.
# Using docker-compose.external-db.yml instead? Replace this with your own
# connection string (Neon, Supabase, RDS, …).
DATABASE_URL=postgresql://postgres:support@postgres:5432/support_tool

# Session/crypto secret — MUST be at least 32 random characters.
# Generate one:  openssl rand -base64 36
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL of this instance (used in every email link). No trailing slash.
# MUST be the URL your users actually reach — not localhost — in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Host port — optional ──────────────────────────────────────────────────────
# Which port on the HOST maps to the app. Change it if 3000 is already taken.
# HOST_PORT=8080
#
# Do NOT set PORT here. Compose passes every var in this file into the container,
# and `next start` reads PORT — so setting PORT would move the app's port *inside*
# the container too, breaking the port mapping and the container healthcheck. The
# compose files pin the internal port to 3000 for exactly that reason.

# ── Email (SMTP) — optional ───────────────────────────────────────────────────
# Without these, email sends are logged by the worker instead of delivered
# (`docker compose logs -f worker` to read the magic links / ticket links).
# Works with any SMTP provider: Mailtrap, SendGrid, Postmark, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Google OAuth — optional ───────────────────────────────────────────────────
# Enables the "Continue with Google" button on the agent/admin login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Pusher Beams (browser/OS push) — optional ─────────────────────────────────
# OS-level push to agents when a customer replies, even with the app closed.
# From https://dashboard.pusher.com → Beams.
#
# ⚠ NEXT_PUBLIC_* is baked into the browser bundle at BUILD time. The compose
#   files read it from this file via `build.args:` automatically, but changing
#   it later requires a rebuild:  docker compose build && docker compose up -d
#   A plain `docker compose restart` will NOT pick it up.
NEXT_PUBLIC_PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=

# ── Pusher Channels (real-time ticket updates) — optional ────────────────────
# A DIFFERENT Pusher product from Beams above (pub/sub, not push). When set,
# the agent ticket list and open ticket pages update live with no refresh.
# From https://dashboard.pusher.com → Channels (a new Channels app).
# Same build-time caveat as above for the NEXT_PUBLIC_* values.
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Email Webhook — optional ──────────────────────────────────────────────────
# Set to receive delivery events from your SMTP provider.
# Accepts Authorization: Bearer <secret> or x-webhook-secret header.
# EMAIL_WEBHOOK_SECRET=

# ── File Storage — optional ───────────────────────────────────────────────────
# Default is "local": ticket attachments go to /app/uploads inside the
# container, which the compose files mount as the persistent
# `support_tool_uploads` volume. Do NOT remove that volume — without it every
# redeploy resets the container filesystem and wipes all attachments.
#
# Set STORAGE_DRIVER=s3 or =r2 for cloud object storage instead — survives
# host loss and works across multiple app replicas, no volume needed.
# STORAGE_DRIVER=local

# --- s3 (also covers any S3-compatible provider) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# Credentials come from the standard AWS chain (env vars below, IAM role, or a
# shared profile) — not a Docket-specific var.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- r2 (Cloudflare R2) ---
# STORAGE_DRIVER=r2
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional for either cloud driver: a CDN/custom domain bound to the bucket.
# Docket always serves files through its own /api/files/[...key] route
# regardless of driver, so this only matters if you point other tooling at the
# bucket directly.
# STORAGE_PUBLIC_BASE_URL=
