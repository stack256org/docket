# ─────────────────────────────────────────────────────────────────────────────
# Docket — Docker Compose environment
#
#   cp .env.docker.example .env
#   # edit APP_SECRET + NEXT_PUBLIC_APP_URL below, then:
#   docker compose up -d
#
# This is the DOCKER variant of .env.example. The only difference that matters
# is DATABASE_URL: inside Compose the database is reachable at the service
# hostname `postgres`, not `localhost`. Everything else is identical.
# ─────────────────────────────────────────────────────────────────────────────

# These are the only required env vars — see below for optional integrations.
# Pre-filled to match the bundled `postgres` service in docker-compose.yml.
# Using docker-compose.external-db.yml instead? Replace this with your own
# connection string (Neon, Supabase, RDS, …).
DATABASE_URL=postgresql://postgres:support@postgres:5432/support_tool

# Session/crypto secret — MUST be at least 32 random characters.
# Generate one:  openssl rand -base64 36
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL of this instance (used in every email link). No trailing slash.
# MUST be the URL your users actually reach — not localhost — in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Everything else (host port, SMTP, Google OAuth, Pusher, file storage) is
# optional and can instead be set from the app itself — the setup wizard's
# "Integrations" step (skippable, revisit any time), or later from
# Admin → Integrations.
