# These are the only required env vars — see below for optional integrations.
# Postgres connection string. For Docker Compose this is set automatically.
DATABASE_URL=postgresql://postgres:support@localhost:5432/docket
# when use docker use postgres instead of localhost, like this:
#  DATABASE_URL=postgresql://postgres:support@postgres:5432/docket

# Session/crypto secret — MUST be at least 32 random characters.
APP_SECRET=replace-with-at-least-32-random-characters
# Public base URL of this instance (used in email links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Everything else (SMTP, Google OAuth, Pusher, file storage) is optional and can
# instead be set from the app itself — the setup wizard's "Integrations" step
# (skippable, revisit any time), or later from Admin → Integrations.
